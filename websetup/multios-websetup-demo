#!/bin/bash

# Variables Declaration
PACKAGE="httpd wget unzip"
SVC="httpd"
URL="### static website template ###"
ART_NAME="###"
TEMPDIR="/tmp/webfiles"

# Detect Linux Distribution
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS=$ID
else
    echo "Unknown operating system. Exiting..."
    exit 1
fi

# Function for installing packages based on the OS
install_packages() {
    case $OS in
        ubuntu)
            PACKAGE="apache2 wget unzip"
            SVC="apache2"
            sudo apt update -y
            sudo apt install -y $PACKAGE
            ;;
        centos|amzn)
            sudo yum install -y $PACKAGE
            ;;
        *)
            echo "Unsupported OS: $OS"
            exit 1
            ;;
    esac
}

# Function to manage the web service (start, enable)
manage_service() {
    sudo systemctl start $SVC
    sudo systemctl enable $SVC
}

# Install dependencies
echo "########################"
echo "Installing packages."
echo "########################"
install_packages
echo

# Start & Enable Service
echo "########################"
echo "Starting and Enabling HTTPD/Apache2 Service"
echo "########################"
manage_service
echo

# Creating Temp Directory
echo "########################"
echo "Starting Artifact Deployment"
echo "########################"
mkdir -p $TEMPDIR
cd $TEMPDIR || exit 1

# Download and deploy artifact
if wget $URL -O "$ART_NAME.zip" > /dev/null 2>&1; then
    unzip "$ART_NAME.zip" > /dev/null 2>&1
    sudo cp -r $ART_NAME/* /var/www/html/
else
    echo "Failed to download the artifact. Exiting..."
    exit 1
fi
echo

# Restart Service
echo "########################"
echo "Restarting HTTPD/Apache2 Service"
echo "########################"
sudo systemctl restart $SVC
echo

# Clean Up
echo "########################"
echo "Removing Temp Files"
echo "########################"
rm -rf $TEMPDIR
echo
echo "-----------------------"
echo "         DONE!         "
echo "-----------------------"
echo
sudo systemctl status $SVC
echo
ls /var/www/html
